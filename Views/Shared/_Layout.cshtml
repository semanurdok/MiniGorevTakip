<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Mini Görev Takip</title>
    <!-- Bootstrap CDN'den yüklenir: bu sayfayı açan cihazın internete erişimi olmalı. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand fw-semibold" asp-controller="Tasks" asp-action="Index">✅ Mini Görev Takip</a>
            <a class="btn btn-light btn-sm" asp-controller="Tasks" asp-action="Create">+ Yeni Görev</a>
        </div>
    </nav>

    <main class="container pb-5">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="text-center text-muted small pb-4">
        Mini Görev Takip &middot; Staj öğrenme projesi
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
